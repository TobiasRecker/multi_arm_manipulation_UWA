<?xml version="1.0"?>
<package format="3">
  <name>uwa_cell_visualization</name><version>0.1.0</version>
  <description>Read-only measured UR overlays alongside the simulated UWA cell.</description>
  <maintainer email="rosmatch@example.com">rosmatch</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>uwa_cell_description</exec_depend><exec_depend>match_ur_hardware</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>ur_description</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend><test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend><test_depend>python3-scipy</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
