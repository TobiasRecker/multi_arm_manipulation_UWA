Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Background Color: 45; 48; 54
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Parametric UWA cell
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /uwa_cell/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: Mount and robot frames
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: UNREGISTERED scan reference
      Enabled: true
      Topic:
        Value: /uwa_cell/scan_reference
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Decay Time: 0
      Alpha: 0.65
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.9}
      Pitch: 0.55
      Yaw: 4.2
Window Geometry:
  Width: 1100
  Height: 800
