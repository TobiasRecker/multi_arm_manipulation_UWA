Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 45; 48; 54
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: SIMULATION - UWA cell (transparent)
      Alpha: 0.40
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /uwa_cell/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: MEASURED - right front (gold)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /uwa_cell/real/right_front/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
    - Class: rviz_default_plugins/RobotModel
      Name: MEASURED - right rear (cyan)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /uwa_cell/real/right_rear/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
    - Class: rviz_default_plugins/MarkerArray
      Name: Hardware data status - LIVE / WAITING / STALE
      Enabled: true
      Topic:
        Value: /uwa_cell/real/status_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: Mount and robot frames
      Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: OAK overview camera and frustum
      Enabled: true
      Topic:
        Value: /uwa_cell/oak_overview/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: UNREGISTERED scan reference
      Enabled: true
      Topic:
        Value: /uwa_cell/scan_reference
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Decay Time: 0
      Alpha: 0.65
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
      Distance: 5.0
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.9}
      Pitch: 0.55
      Yaw: 4.2
Window Geometry:
  Width: 1100
  Height: 800
