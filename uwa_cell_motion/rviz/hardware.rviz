Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 24; 28; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: World reference - provisional anchors
      Enabled: true
      Plane Cell Count: 30
      Cell Size: 0.25
    - Class: rviz_default_plugins/RobotModel
      Name: Actual arms - unknown finger visuals hidden
      Enabled: true
      Alpha: 0.5
      Description Source: Topic
      Description Topic:
        Value: /uwa_cell/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: HARDWARE guard - opening envelopes / distances / state
      Enabled: true
      Topic:
        Value: /uwa_cell/collision_guard/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: INDEPENDENT stop adapter and watchdog status
      Enabled: true
      Topic:
        Value: /uwa_cell/collision_supervisor/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
      Distance: 6.0
      Focal Point: {X: 0.0, Y: 0.0, Z: 1.1}
      Pitch: 0.55
      Yaw: 4.2
Window Geometry:
  Width: 1400
  Height: 900
